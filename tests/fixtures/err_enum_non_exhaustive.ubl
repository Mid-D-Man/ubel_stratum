// tests/fixtures/err_enum_non_exhaustive.ubl
// ENUM_RULES.md — West is never covered. A wildcard arm (`_ => ...`)
// would close this and is real now (see ok_wildcard_and_discard_isolated.ubl)
// -- deliberately not used here, so this fixture still demonstrates
// what happens without one.
// Expected: sema FAIL (NonExhaustiveMatch).

enum Direction {
    North,
    South,
    East,
    West
}

fn describe(d: Direction) string {
    match d {
        North => return "heading north",
        South => return "heading south",
        East  => return "heading east",
    }
}

fn main() void {
    let desc = describe(Direction.North)
}
