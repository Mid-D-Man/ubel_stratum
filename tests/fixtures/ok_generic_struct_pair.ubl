// tests/fixtures/ok_generic_struct_pair.ubl
// GENERICS_RULES.md — a two-type-param generic struct: static
// construction, external field access, and an instance method
// (`swap`) whose return type reorders the struct's own generic params
// (`Pair<B, A>`, not just `Pair<A, B>`) — a real substitution exercise,
// not just an identity passthrough of a single T.
// Expected: zero errors, all assertions pass.

struct Pair<A, B> {
    first:  A
    second: B

    pub fn new(a: A, b: B) Pair<A, B> {
        return Pair { first = a, second = b }
    }

    pub fn swap(self) Pair<B, A> {
        return Pair { first = self.second, second = self.first }
    }
}

fn main() void {
    let p = Pair.new(1, "one")
    assert(p.first == 1, "external field access on a generic struct")
    assert(p.second == "one", "second field, different T from the first")

    let q = p.swap()
    assert(q.first == "one", "swap: instance method returning the struct with params reordered")
    assert(q.second == 1, "swap: second field after reordering")
}
