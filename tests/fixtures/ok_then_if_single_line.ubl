// tests/fixtures/ok_then_if_single_line.ubl
// The `then` keyword: single-line if/elif/else branches, coexisting
// with the existing `{ block }` form. Styles can mix freely within one
// chain — each branch is parsed independently.
// Exercises: `then` as an expression value, `then` as a plain
// statement, `then return` as an early-guard clause (the statement
// carve-out `then` shares with match-arm bodies), and a fully
// then-only chain used as the tail expression of a function.
// Expected: zero errors, all assertions pass.

fn classify(n: int) string {
    if n < 0 then return "negative"
    elif n == 0 then return "zero"
    else { return "positive" }
}

fn abs_value(n: int) int {
    // Whole chain in `then` form, used as a value (no `return` needed —
    // the if-expression's own value becomes the function's tail value).
    return if n < 0 then -n else then n
}

fn mixed_style(n: int) int {
    // Deliberately mixes `{ block }` and `then` in the same chain.
    if n > 100 {
        let scaled = n / 10
        return scaled
    } elif n > 10 then return n - 10
    else then 0
}

fn main() void {
    assert(classify(-5) == "negative", "then + return as a guard clause")
    assert(classify(0)  == "zero",     "elif then + return")
    assert(classify(7)  == "positive", "else stays block-form")

    assert(abs_value(-8) == 8, "then-only if/else chain used as a value")
    assert(abs_value(8)  == 8, "then-only if/else chain, positive branch")

    assert(mixed_style(150) == 15, "block-form then branch")
    assert(mixed_style(50)  == 40, "then-form elif branch")
    assert(mixed_style(5)   == 0,  "then-form else branch")

    // `then` used directly as a statement, value discarded.
    let x = 3
    if x > 0 then println("positive branch reached")
}
