// tests/fixtures/err_top_level_collision.ubl
// A function and a struct are both named `Config` at the top level.
// Expected: exactly 1 NameError::DuplicateDefinition for `Config`.

struct Config {
    host: string
    port: int
}

fn Config() string {
    return "oops"
}

fn main() void {
    let c = Config()
}
