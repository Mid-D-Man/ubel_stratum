// .mdix/patches/patch.mdix
// =============================================================================
// Patch batch 2 — post-batch-1 remaining issues
//   Fix 1 — logos priority 2 → 3 (file currently has 2 from last run)
//   Fix 2 — remove unused `use crate::lexer::Span` in diagnostics.rs
// =============================================================================

@CONFIG(
  version    -> "1.0.0"
  author     -> "Mid-D-Man"
  debug_mode -> "regular"
)

@QUICKFUNCS(

  ~patch_replace_text<object>(path, anchor, content) {
    return { path = path, op = "replace_text", anchor = anchor, content = content }
  }

)

@DATA(

  patch_files::

    // ── Fix 1: logos still rejects priority = 2, needs priority = 3 ──────────
    // logos_lexer.rs:157
    // The file currently has the result of the last patch (priority = 2).
    // Anchor is the literal string as it now exists on disk.
    patch_replace_text(
      "crates/core/src/lexer/logos_lexer.rs",
      "#[regex(r\"[a-zA-Z_][a-zA-Z0-9_]*\", priority = 2)]",
      "#[regex(r\"[a-zA-Z_][a-zA-Z0-9_]*\", priority = 3)]"
    )

    // ── Fix 2: unused import — `use crate::lexer::Span` in diagnostics.rs ────
    // Including the newline in the anchor removes the whole line cleanly.
    patch_replace_text(
      "crates/core/src/error_management/diagnostics.rs",
      "use crate::lexer::Span;\n",
      ""
    )

)
