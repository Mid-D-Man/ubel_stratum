// .mdix/patches/patch.mdix
// =============================================================================
// Patch batch 8 — fix E0063 in crates/core/src/sema/tests.rs (CI run #126)
//   StructDecl gained `attributes` and `lifetime_params` fields a while back
//   (see docs/ubel.ebnf batch 5), but these two test-only struct literals
//   were never updated to match, so `cargo test --workspace` fails to even
//   compile. Both call sites get the same two fields, both empty (these
//   tests don't exercise attributes or lifetimes).
// =============================================================================

@CONFIG(
  version    -> "1.0.0"
  author     -> "Mid-D-Man"
  debug_mode -> "regular"
)

@QUICKFUNCS(
  ~patch_replace_text<object>(path, anchor, content) {
    return { path = path, op = "replace_text", anchor = anchor, content = content }
  }
)

@DATA(
  patch_files::

    // ── Fix 1: test_sema_empty_struct_ok ───────────────────────────────────────
    patch_replace_text(
      "crates/core/src/sema/tests.rs",
      "let s = StructDecl {\n        visibility:     Visibility::default(),\n        is_edge:        false,\n        name:           arena.alloc_str(\"Point\"),\n        generic_params: &[],\n        members:        &[],\n        span:           Z,\n    };",
      "let s = StructDecl {\n        attributes:      &[],\n        visibility:      Visibility::default(),\n        is_edge:         false,\n        name:            arena.alloc_str(\"Point\"),\n        lifetime_params: &[],\n        generic_params:  &[],\n        members:         &[],\n        span:            Z,\n    };"
    )

    // ── Fix 2: test_sema_struct_and_fn_ok ──────────────────────────────────────
    patch_replace_text(
      "crates/core/src/sema/tests.rs",
      "let s = StructDecl {\n        visibility:     Visibility::default(),\n        is_edge:        false,\n        name:           arena.alloc_str(\"Vec3\"),\n        generic_params: &[],\n        members:        &[],\n        span:           Z,\n    };",
      "let s = StructDecl {\n        attributes:      &[],\n        visibility:      Visibility::default(),\n        is_edge:         false,\n        name:            arena.alloc_str(\"Vec3\"),\n        lifetime_params: &[],\n        generic_params:  &[],\n        members:         &[],\n        span:            Z,\n    };"
    )
)
