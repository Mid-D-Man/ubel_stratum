// .mdix/patches/patch.mdix
// =============================================================================
// Patch batch 9 — fix E0063 in crates/core/benches/ast_bench.rs
//   Same root cause as batch 8 (sema/tests.rs): StructDecl/ConstDecl grew
//   `attributes` (both) and `lifetime_params` (StructDecl only) fields a
//   while back, and these three bench-only struct literals were never
//   updated. `cargo test --workspace --all-targets` compiles benches too,
//   so this was failing the CI build the same way sema/tests.rs was.
//   Verified by actually compiling AND running the benchmark after the
//   fix — ast/struct_decl/* benches produce real timing output.
// =============================================================================

@CONFIG(
  version    -> "1.0.0"
  author     -> "Mid-D-Man"
  debug_mode -> "regular"
)

@QUICKFUNCS(
  ~patch_replace_text<object>(path, anchor, content) {
    return { path = path, op = "replace_text", anchor = anchor, content = content }
  }
)

@DATA(
  patch_files::

    // ── Fix 1: StructDecl at line ~466 (MyStruct, direct black_box case) ──────
    patch_replace_text(
      "crates/core/benches/ast_bench.rs",
      "let decl = StructDecl {\n                        visibility: Visibility::Public,\n                        is_edge: false,\n                        name: arena.alloc_str(\"MyStruct\"),\n                        generic_params: &[],\n                        members: members.into_bump_slice(),\n                        span: DUMMY,\n                    };",
      "let decl = StructDecl {\n                        attributes: &[],\n                        visibility: Visibility::Public,\n                        is_edge: false,\n                        name: arena.alloc_str(\"MyStruct\"),\n                        lifetime_params: &[],\n                        generic_params: &[],\n                        members: members.into_bump_slice(),\n                        span: DUMMY,\n                    };"
    )

    // ── Fix 2: ConstDecl (MAX) ──────────────────────────────────────────────────
    patch_replace_text(
      "crates/core/benches/ast_bench.rs",
      "items.push(Item::Const(ConstDecl {\n                name: arena.alloc_str(\"MAX\"),\n                ty: Some(int_ty),\n                value: int_lit(&arena, 100),\n                span: DUMMY,\n            }));",
      "items.push(Item::Const(ConstDecl {\n                attributes: &[],\n                name: arena.alloc_str(\"MAX\"),\n                ty: Some(int_ty),\n                value: int_lit(&arena, 100),\n                span: DUMMY,\n            }));"
    )

    // ── Fix 3: StructDecl (Point) ────────────────────────────────────────────────
    patch_replace_text(
      "crates/core/benches/ast_bench.rs",
      "items.push(Item::Struct(StructDecl {\n                visibility: Visibility::Public,\n                is_edge: false,\n                name: arena.alloc_str(\"Point\"),\n                generic_params: &[],\n                members: fields.into_bump_slice(),\n                span: DUMMY,\n            }));",
      "items.push(Item::Struct(StructDecl {\n                attributes: &[],\n                visibility: Visibility::Public,\n                is_edge: false,\n                name: arena.alloc_str(\"Point\"),\n                lifetime_params: &[],\n                generic_params: &[],\n                members: fields.into_bump_slice(),\n                span: DUMMY,\n            }));"
    )
)
