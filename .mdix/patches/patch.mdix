// .mdix/patches/patch.mdix
// =============================================================================
// Patch batch 3
//   Fix 1 — Underscore token needs priority = 4 to beat Ident priority = 3
//   Fix 2 — test_all_tier_keywords: tier IS a logos keyword, fix the assertion
//   Fix 3 — unused import Span in ast/literals.rs
//   Fix 4 — unused GenericParam + LifetimeParam in ast/types.rs
//   Fix 5 — unused EnumPayload import in eval/expr.rs
//   Fix 6 — unused variable `payload` in eval/expr.rs
//   Fix 7 — unused variable `descending` in eval/expr.rs
// =============================================================================

@CONFIG(
  version    -> "1.0.0"
  author     -> "Mid-D-Man"
  debug_mode -> "regular"
)

@QUICKFUNCS(

  ~patch_replace_text<object>(path, anchor, content) {
    return { path = path, op = "replace_text", anchor = anchor, content = content }
  }

)

@DATA(

  patch_files::

    // ── Fix 1: Underscore needs higher priority than Ident ────────────────────
    // logos_lexer.rs:81
    // Ident is priority=3. Bare `_` must tokenise as Underscore, not Ident("_").
    // Give Underscore priority=4 so it beats Ident for the single-char `_` case.
    patch_replace_text(
      "crates/core/src/lexer/logos_lexer.rs",
      "#[token(\"_\")] Underscore,",
      "#[token(\"_\", priority = 4)] Underscore,"
    )

    // ── Fix 2: tier IS a logos keyword — fix the test assertion ───────────────
    // tests.rs:70
    // `#[token("tier")] Tier` in logos_lexer.rs means `tier` is always
    // TokenType::Tier, never Ident. The test comment was wrong about the design.
    // Fix: assert Tier instead of Ident.
    patch_replace_text(
      "crates/core/src/lexer/tests.rs",
      "matches!(tokens[1].kind, TokenType::Ident(ref s) if s == \"tier\")",
      "matches!(tokens[1].kind, TokenType::Tier)"
    )

    // ── Fix 3: unused import `Span` in ast/literals.rs ───────────────────────
    patch_replace_text(
      "crates/core/src/ast/literals.rs",
      "use crate::ast::common::Span;\n",
      ""
    )

    // ── Fix 4: unused imports GenericParam + LifetimeParam in ast/types.rs ───
    // Span IS used; only the other two are not.
    patch_replace_text(
      "crates/core/src/ast/types.rs",
      "use crate::ast::common::{Span, GenericParam, LifetimeParam};",
      "use crate::ast::common::Span;"
    )

    // ── Fix 5: unused import EnumPayload in eval/expr.rs ─────────────────────
    patch_replace_text(
      "crates/core/src/interpreter/eval/expr.rs",
      "{EnumPayload, EvalResult, Signal, Value}",
      "{EvalResult, Signal, Value}"
    )

    // ── Fix 6: unused variable `payload` in eval/expr.rs:579 ─────────────────
    patch_replace_text(
      "crates/core/src/interpreter/eval/expr.rs",
      ", ref payload }",
      ", payload: _ }"
    )

    // ── Fix 7: unused variable `descending` in eval/expr.rs:897 ─────────────
    patch_replace_text(
      "crates/core/src/interpreter/eval/expr.rs",
      "descending }",
      "descending: _ }"
    )

)
