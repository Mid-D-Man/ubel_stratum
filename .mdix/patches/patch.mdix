// .mdix/patches/patch.mdix
// =============================================================================
// Patch batch 4 — wire test modules into sema and interpreter
//   Fix 1 — add #[cfg(test)] mod tests; to sema/mod.rs
//   Fix 2 — add #[cfg(test)] mod tests; to interpreter/eval/mod.rs
// The test files themselves are committed as new files alongside this patch.
// =============================================================================

@CONFIG(
  version    -> "1.0.0"
  author     -> "Mid-D-Man"
  debug_mode -> "regular"
)

@QUICKFUNCS(

  ~patch_replace_text<object>(path, anchor, content) {
    return { path = path, op = "replace_text", anchor = anchor, content = content }
  }

)

@DATA(

  patch_files::

    // ── Fix 1: add test module declaration to sema/mod.rs ─────────────────────
    // Anchors on the last pub mod in the module block — guaranteed unique.
    patch_replace_text(
      "crates/core/src/sema/mod.rs",
      "pub mod tier_check;",
      "pub mod tier_check;\n\n#[cfg(test)]\nmod tests;"
    )

    // ── Fix 2: add test module declaration to interpreter/eval/mod.rs ─────────
    patch_replace_text(
      "crates/core/src/interpreter/eval/mod.rs",
      "pub mod pattern;",
      "pub mod pattern;\n\n#[cfg(test)]\nmod tests;"
    )

)
