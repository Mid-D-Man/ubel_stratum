// .mdix/patches/patch.mdix
// =============================================================================
// Patch batch 11 — fix the real lexer bug in string_parser.rs
//   Root cause: `position` is treated as a CHARACTER count throughout the
//   scanner (char_at uses .chars().nth(pos), and every catch-all match arm
//   does `self.position += 1` regardless of the matched char's byte width),
//   but final lexeme/span slicing (`&self.input[start..end]`) treats it as
//   a BYTE offset. These agree for pure ASCII input and silently diverge
//   the moment any multi-byte UTF-8 character (e.g. an em dash "—" in a
//   comment) appears anywhere earlier in the file — every position after
//   that point is off, which is why the reported error spans looked like
//   runaway consumption (e.g. start:1 end:170) rather than a clean failure
//   right at the interpolation hole.
//   Five edits: char_at becomes byte-offset-correct, and the four
//   catch-all `_ => { ...; self.position += 1; ... }` arms (one per
//   parsing function: interpolated string, interpolation-hole expr,
//   verbatim string, interpolated verbatim string) advance by
//   `ch.len_utf8()` instead of a flat 1.
//   Verified against the live repo (commit 8bf672c6): cargo build clean,
//   cargo test -p ubel_stratum --lib -> 49/49 pass, and directly re-ran
//   the tool against every fixture — lex: ok across all 13, including
//   ok_struct_methods.ubl and ok_nested_scopes.ubl which were failing.
// =============================================================================

@CONFIG(
  version    -> "1.0.0"
  author     -> "Mid-D-Man"
  debug_mode -> "regular"
)

@QUICKFUNCS(
  ~patch_replace_lines<object>(path, start_line, end_line, content) {
    return { path = path, op = "replace_lines", start_line = start_line, end_line = end_line, content = content }
  }
)

@DATA(
  patch_files::

    // ── Fix 1: catch-all in parse_interpolated_string ──────────────────────────
    patch_replace_lines(
      "crates/core/src/lexer/string_parser.rs",
      138, 138,
      "                    self.position += ch.len_utf8();\n"
    )

    // ── Fix 2: catch-all in parse_interpolation_expr ────────────────────────────
    patch_replace_lines(
      "crates/core/src/lexer/string_parser.rs",
      186, 186,
      "                    self.position += ch.len_utf8();\n"
    )

    // ── Fix 3: catch-all in parse_verbatim_string ───────────────────────────────
    patch_replace_lines(
      "crates/core/src/lexer/string_parser.rs",
      253, 253,
      "                    self.position += ch.len_utf8();\n"
    )

    // ── Fix 4: catch-all in parse_interpolated_verbatim_string ──────────────────
    patch_replace_lines(
      "crates/core/src/lexer/string_parser.rs",
      331, 331,
      "                    self.position += ch.len_utf8();\n"
    )

    // ── Fix 5: char_at — byte-offset-correct instead of char-count-based ───────
    patch_replace_lines(
      "crates/core/src/lexer/string_parser.rs",
      345, 345,
      "        self.input[pos..].chars().next().unwrap_or('\\0')\n"
    )
)
