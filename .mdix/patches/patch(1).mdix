// .mdix/patches/patch.mdix
// =============================================================================
// Patch batch 11b — same fix as batch 11, corrected field names
//   Batch 11's patch_replace_lines() returned an object with `start_line`/
//   `end_line` fields. The real engine (lib_patch.py, op_replace_lines)
//   reads entry["from_line"]/entry["to_line"] — different names — so all
//   5 ops failed with "bad from_line/to_line: 'from_line'" (KeyError,
//   surfaced as that message) and 0/5 patched. Confirmed against the
//   actual mdix-scaffold source this time, not the README's calling-
//   convention example (which only shows local parameter names, not the
//   object's required field names — that's the actual gap that caused
//   the mismatch).
//   Same 5 edits, same verified fix (49/49 tests pass, lex: ok across all
//   13 fixtures — see previous message). Re-confirmed line numbers still
//   match on current HEAD (4b0c1de) before generating this.
// =============================================================================

@CONFIG(
  version    -> "1.0.0"
  author     -> "Mid-D-Man"
  debug_mode -> "regular"
)

@QUICKFUNCS(
  ~patch_replace_lines<object>(path, from_line, to_line, content) {
    return { path = path, op = "replace_lines", from_line = from_line, to_line = to_line, content = content }
  }
)

@DATA(
  patch_files::

    // ── Fix 1: catch-all in parse_interpolated_string ──────────────────────────
    patch_replace_lines(
      "crates/core/src/lexer/string_parser.rs",
      138, 138,
      "                    self.position += ch.len_utf8();\n"
    )

    // ── Fix 2: catch-all in parse_interpolation_expr ────────────────────────────
    patch_replace_lines(
      "crates/core/src/lexer/string_parser.rs",
      186, 186,
      "                    self.position += ch.len_utf8();\n"
    )

    // ── Fix 3: catch-all in parse_verbatim_string ───────────────────────────────
    patch_replace_lines(
      "crates/core/src/lexer/string_parser.rs",
      253, 253,
      "                    self.position += ch.len_utf8();\n"
    )

    // ── Fix 4: catch-all in parse_interpolated_verbatim_string ──────────────────
    patch_replace_lines(
      "crates/core/src/lexer/string_parser.rs",
      331, 331,
      "                    self.position += ch.len_utf8();\n"
    )

    // ── Fix 5: char_at — byte-offset-correct instead of char-count-based ───────
    patch_replace_lines(
      "crates/core/src/lexer/string_parser.rs",
      345, 345,
      "        self.input[pos..].chars().next().unwrap_or('\\0')\n"
    )
)
