
// =============================================================================
// Converts the repo from a mixed workspace (root-is-also-a-package) to a
// clean virtual workspace with every crate under crates/.
//
// Operations:
//   DEL  build.rs                         (empty, root no longer a package)
//   MOV  src/            → crates/core/src/
//   MOV  benches/        → crates/core/benches/
//   MOV  ubel_stratum_parser/ → crates/parser/
//   UPD  Cargo.toml             (virtual workspace, members updated)
//   NEW  crates/core/Cargo.toml (package manifest extracted from root)
//   PCH  crates/parser/Cargo.toml  path=".." → path="../core"
//
// Run via workspace-restructure.yml — dry_run=true first!
// =============================================================================

@CONFIG(
  version    -> "1.0.0"
  author     -> "Mid-D-Man"
  features   -> "advanced"
  debug_mode -> "regular"
)

@QUICKFUNCS(

  ~move<object>(src, dst) {
    return { from_path = src, to_path = dst }
  }

  ~delete_file<object>(path) {
    return { path = path }
  }

  ~update<object>(path, content) {
    return { path = path, content = content }
  }

  ~patch_replace_text<object>(path, anchor, content) {
    return { path = path, op = "replace_text", anchor = anchor, content = content }
  }

)

@DATA(

  // ── Pass 1: Remove root artefacts that belong to the package layer ────────
  delete_files::
    delete_file("build.rs")

  // ── Pass 2: Move source trees — shutil.move handles full directories ──────
  // Parent dirs (crates/core/, crates/parser/) are auto-created by generate_structure.py
  move_files::
    move("src",                  "crates/core/src")
    move("benches",              "crates/core/benches")
    move("ubel_stratum_parser",  "crates/parser")

  // ── Pass 4: Write Cargo manifests ────────────────────────────────────────
  update_files::

    // Root Cargo.toml → pure virtual workspace, NO [package] section.
    // Profiles stay here so all workspace members inherit them.
    update("Cargo.toml",
      "[workspace]\nmembers  = [\"crates/core\", \"crates/parser\"]\nresolver = \"2\"\n\n# Profiles are workspace-level; all crates inherit without re-declaring.\n[profile.release]\nopt-level     = 3\nlto           = true\ncodegen-units = 1\nstrip         = true\n\n[profile.bench]\ninherits      = \"release\"\nlto           = false\ncodegen-units = 4\n"
    )

    // crates/core/Cargo.toml — extracted from the old root [package].
    // No profiles here; they're inherited from the workspace root above.
    update("crates/core/Cargo.toml",
      "[package]\nname        = \"ubel_stratum\"\nversion     = \"0.1.0\"\nedition     = \"2021\"\nauthors     = [\"Mid-D-Man\"]\nlicense     = \"MIT OR Apache-2.0\"\ndescription = \"Ubel Stratum - core library (lexer, AST, sema, interpreter)\"\nrepository  = \"https://github.com/Mid-D-Man/ubel_stratum\"\n\n[dependencies]\nthiserror   = \"1.0\"\nmiette      = { version = \"7.0\",  features = [\"fancy\"] }\nphf         = { version = \"0.11\", features = [\"macros\"] }\nlazy_static = \"1.4\"\nbumpalo     = { version = \"3\",    features = [\"collections\"] }\nlogos       = \"0.14\"\n\n[dev-dependencies]\ncriterion = { version = \"0.5\", features = [\"html_reports\"] }\nproptest  = \"1.4\"\n\n[lib]\nname = \"ubel_stratum\"\npath = \"src/lib.rs\"\n\n[[bench]]\nname    = \"lexer_bench\"\nharness = false\n\n[[bench]]\nname    = \"ast_bench\"\nharness = false\n"
    )

  // ── Pass 5: Surgical patch — fix path dep after directory move ────────────
  // Before: ubel_stratum = { path = ".."       }   (pointed at repo root)
  // After:  ubel_stratum = { path = "../core"  }   (points at crates/core)
  patch_files::
    patch_replace_text(
      "crates/parser/Cargo.toml"
      "path = \"..\""
      "path = \"../core\""
    )

)
